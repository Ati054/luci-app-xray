#!/bin/sh /etc/rc.common

START=99
STOP=15
USE_PROCD=1
NAME=xray_core

XRAY_RUNTIME_DIR="${XRAY_RUNTIME_DIR:-/var/etc/xray}"
XRAY_RUN_DIR="${XRAY_RUN_DIR:-/var/run}"
XRAY_NFTABLES_DIR="${XRAY_NFTABLES_DIR:-/etc/nftables.d}"
DNSMASQ_RUNTIME_ROOT="${DNSMASQ_RUNTIME_ROOT:-/tmp}"
FIREWALL_INIT="${FIREWALL_INIT:-/etc/init.d/firewall}"
DNSMASQ_INIT="${DNSMASQ_INIT:-/etc/init.d/dnsmasq}"
IP_BIN="${IP_BIN:-ip}"
UCODE_BIN="${UCODE_BIN:-/usr/bin/ucode}"
UTPL_BIN="${UTPL_BIN:-/usr/bin/utpl}"
TPROXY_MARKER="${TPROXY_MARKER:-${XRAY_RUN_DIR}/xray_tproxy.active}"

uci_get_by_type() {
    local ret
    ret="$(uci get "${NAME}.@${1}[0].${2}" 2>/dev/null)" || true
    echo "${ret:-$3}"
}

is_reverse_only() {
    [ "$(uci_get_by_type general reverse_only 1)" = "1" ]
}

is_transparent_proxy() {
    ! is_reverse_only && [ "$(uci_get_by_type general transparent_proxy_enable 0)" = "1" ]
}

has_tproxy_artifacts() {
    [ -f "${TPROXY_MARKER}" ] && return 0
    [ -f "${XRAY_RUNTIME_DIR}/01_firewall_include.nft" ] && return 0
    [ -f "${DNSMASQ_RUNTIME_ROOT}/dnsmasq.d/xray.conf" ] && return 0
    local f
    for f in "${DNSMASQ_RUNTIME_ROOT}"/dnsmasq.*.d/xray.conf; do
        [ -f "${f}" ] && return 0
    done
    if "${IP_BIN}" rule show 2>/dev/null | grep -E -q "fwmark (0xfb|251) lookup 251(\b|$)"; then
        return 0
    fi
    if "${IP_BIN}" -6 rule show 2>/dev/null | grep -E -q "fwmark (0xfb|251) lookup 251(\b|$)"; then
        return 0
    fi
    return 1
}

setup_firewall() {
    "${IP_BIN}" rule add fwmark 251 lookup 251 2>/dev/null || true
    "${IP_BIN}" route add local default dev lo table 251 2>/dev/null || true
    "${IP_BIN}" -6 rule add fwmark 251 lookup 251 2>/dev/null || true
    "${IP_BIN}" -6 route add local default dev lo table 251 2>/dev/null || true

    logger -st "xray[$$]" -p4 "Generating firewall4 rules..."
    "${UTPL_BIN}" /usr/share/xray/firewall_include.ut > "${XRAY_RUNTIME_DIR}/01_firewall_include.nft"

    logger -st "xray[$$]" -p4 "Triggering firewall4 restart..."
    "${FIREWALL_INIT}" restart
}

flush_firewall() {
    "${IP_BIN}" rule del fwmark 251 lookup 251 2>/dev/null || true
    "${IP_BIN}" route del local default dev lo table 251 2>/dev/null || true
    "${IP_BIN}" -6 rule del fwmark 251 lookup 251 2>/dev/null || true
    "${IP_BIN}" -6 route del local default dev lo table 251 2>/dev/null || true

    logger -st "xray[$$]" -p4 "Flushing firewall4 rules..."
    rm -f "${XRAY_RUNTIME_DIR}"/*.nft

    logger -st "xray[$$]" -p4 "Triggering firewall4 restart..."
    "${FIREWALL_INIT}" restart
}

log_procd_set_param() {
    local type="$1"
    shift
    logger -st "xray[$$]" -p4 "Using procd_set_param ${type}" "$@"
}

start_xray() {
    logger -st "xray[$$]" -p4 "Starting Xray from $1"
    procd_open_instance
    procd_set_param respawn 1 1 0
    procd_set_param command "$1"
    procd_append_param command run
    procd_append_param command -confdir
    procd_append_param command "${XRAY_RUNTIME_DIR}"

    local rlimit_nofile=""
    if [ -s /usr/share/xray/rlimit_nofile ]; then
        rlimit_nofile="nofile=$(cat /usr/share/xray/rlimit_nofile)"
    fi

    local rlimit_data=""
    if [ -s /usr/share/xray/rlimit_data ]; then
        rlimit_data="data=$(cat /usr/share/xray/rlimit_data)"
    fi

    if [ -z "${rlimit_nofile}" ]; then
        if [ -n "${rlimit_data}" ]; then
            log_procd_set_param limits "${rlimit_data}"
            procd_set_param limits "${rlimit_data}"
        fi
    else
        if [ -z "${rlimit_data}" ]; then
            log_procd_set_param limits "${rlimit_nofile}"
            procd_set_param limits "${rlimit_nofile}"
        else
            log_procd_set_param limits "${rlimit_data}" "${rlimit_nofile}"
            procd_set_param limits "${rlimit_data}" "${rlimit_nofile}"
        fi
    fi

    local asset_location
    asset_location="$(uci_get_by_type general xray_location_asset /opt/xray/current)"
    procd_set_param env XRAY_LOCATION_ASSET="${asset_location}"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/xray_core
    procd_set_param pidfile "${XRAY_RUN_DIR}/xray.pid"
    procd_close_instance
}

gen_config_file() {
    rm -f "${XRAY_NFTABLES_DIR}/99-xray.nft" "${XRAY_RUNTIME_DIR}"/*
    local gen_config_file_attempt
    for gen_config_file_attempt in 1 2 3 4 5; do
        logger -st "xray[$$]" -p4 "Generating Xray configuration files (attempt ${gen_config_file_attempt})..."
        "${UCODE_BIN}" /usr/share/xray/gen_config.uc > "${XRAY_RUNTIME_DIR}/config.json"
        if [ -s "${XRAY_RUNTIME_DIR}/config.json" ]; then
            break
        else
            sleep 1
        fi
    done
    local custom_config
    custom_config="$(uci_get_by_type general custom_config)"
    if [ -n "${custom_config}" ]; then
        echo "${custom_config}" > "${XRAY_RUNTIME_DIR}/config_custom.json"
    fi
    return 0
}

setup_dnsmasq_instance() {
    local instance_dir="${DNSMASQ_RUNTIME_ROOT}/dnsmasq.${1:+"${1}."}d"
    mkdir -p "${instance_dir}"
    "${UTPL_BIN}" /usr/share/xray/dnsmasq_include.ut > "${instance_dir}/xray.conf"
    logger -st "xray[$$]" -p4 "$(cat "${instance_dir}/xray.conf" 2>/dev/null || true)"
}

setup_dnsmasq() {
    if [ "$(uci_get_by_type general dnsmasq_integration_mode)" = "per_instance" ]; then
        local instance
        for instance in $(uci_get_by_type general dnsmasq_instances); do
            setup_dnsmasq_instance "${instance}"
        done
    else
        config_load dhcp
        setup_dnsmasq_instance
        config_foreach setup_dnsmasq_instance dnsmasq
    fi
    "${DNSMASQ_INIT}" restart >/dev/null 2>&1
}

flush_dnsmasq() {
    rm -f "${DNSMASQ_RUNTIME_ROOT}/dnsmasq.d/xray.conf" "${DNSMASQ_RUNTIME_ROOT}"/dnsmasq.*.d/xray.conf
    "${DNSMASQ_INIT}" restart >/dev/null 2>&1
}

create_when_enable() {
    if is_transparent_proxy; then
        logger -st "xray[$$]" -p4 "Setting dnsmasq and firewall for transparent proxy..."
        setup_dnsmasq
        setup_firewall
        logger -st "xray[$$]" -p4 "$("${UCODE_BIN}" /usr/share/xray/default_gateway.uc)"
        touch "${TPROXY_MARKER}" 2>/dev/null || true
    else
        flush_when_disable
    fi
}

flush_when_disable() {
    if has_tproxy_artifacts; then
        logger -st "xray[$$]" -p4 "Resetting dnsmasq and firewall configurations..."
        flush_dnsmasq
        flush_firewall
        rm -f "${TPROXY_MARKER}"
    fi
}

start_service() {
    config_load "${NAME}"
    mkdir -p "${XRAY_RUN_DIR}" "${XRAY_RUNTIME_DIR}"
    local xray_bin
    xray_bin="$(uci_get_by_type general xray_bin /opt/xray/current/xray)"
    command -v "${xray_bin}" >/dev/null 2>&1 || return 1
    gen_config_file
    start_xray "${xray_bin}"
    create_when_enable || flush_when_disable
}

stop_service() {
    flush_when_disable
}

service_framework_stop() {
    stop
}

service_framework_start() {
    start
}

reload_service() {
    service_framework_stop
    service_framework_start
}

service_triggers() {
    if is_transparent_proxy; then
        procd_add_reload_trigger "xray_core" "dhcp"
    else
        procd_add_reload_trigger "xray_core"
    fi
}
