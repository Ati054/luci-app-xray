{
    "admin/services/xray_profiles": {
        "title": "Xray Reverse",
        "action": {
            "type": "view",
            "path": "xray/profiles"
        },
        "depends": {
            "acl": [
                "luci-app-xray"
            ],
            "uci": {
                "xray_core": true
            }
        }
    },
    "admin/services/xray_core": {
        "title": "Xray (Расширенные настройки)",
        "action": {
            "type": "view",
            "path": "xray/core"
        },
        "depends": {
            "acl": [
                "luci-app-xray"
            ],
            "uci": {
                "xray_core": true
            }
        }
    },
    "admin/services/xray_preview": {
        "title": "Xray (preview)",
        "action": {
            "type": "view",
            "path": "xray/preview"
        },
        "depends": {
            "acl": [
                "luci-app-xray"
            ],
            "uci": {
                "xray_core": {
                    "@general[0]": {
                        "preview_or_deprecated": true
                    }
                }
            }
        }
    }
}