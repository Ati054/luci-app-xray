{
    "luci-app-xray": {
        "description": "Grant access to xray configurations",
        "read": {
            "cgi-io": [
                "exec"
            ],
            "uci": [
                "xray_core"
            ],
            "file": {
                "/usr/libexec/xray-update status": [
                    "exec"
                ],
                "/usr/share/xray/*": [
                    "read"
                ],
                "/opt/xray/current/*": [
                    "read"
                ]
            },
            "ubus": {
                "xray_profiles": [
                    "list",
                    "validate",
                    "diagnostic",
                    "logs"
                ],
                "service": [
                    "list",
                    "status"
                ],
                "file": [
                    "exec",
                    "read"
                ]
            }
        },
        "write": {
            "uci": [
                "xray_core"
            ],
            "file": {
                "/usr/libexec/xray-update check": [
                    "exec"
                ],
                "/usr/libexec/xray-update github-start": [
                    "exec"
                ]
            },
            "ubus": {
                "xray_profiles": [
                    "import",
                    "replace",
                    "delete",
                    "start",
                    "stop",
                    "restart",
                    "set_autostart",
                    "rename",
                    "reorder",
                    "enable_service",
                    "disable_service",
                    "disable_legacy"
                ],
                "service": [
                    "delete"
                ],
                "file": [
                    "exec"
                ]
            },
            "cgi-io": [
                "exec"
            ]
        }
    }
}
