#!/usr/bin/ucode
"use strict";

import { readfile, writefile, open, stat, lstat, access, rename, unlink, chmod, mkdir, rmdir, glob, popen } from "fs";
import { cursor } from "uci";

// Parse CLI flags and arguments
let mock_dir = getenv("XRAY_PROFILES_MOCK_DIR") || null;
let cmd = null;
let method = null;
let args_str = "{}";
let has_args = false;
let stdin_too_large = false;
const MAX_RPC_INPUT_BYTES = 1048576;

for (let i = 0; i < length(ARGV); i++) {
    if (ARGV[i] == "--mock-dir" && i + 1 < length(ARGV)) {
        mock_dir = ARGV[++i];
    } else if (!cmd) {
        cmd = ARGV[i];
    } else if (!method) {
        method = ARGV[i];
    } else if (!has_args) {
        args_str = ARGV[i];
        has_args = true;
    }
}

// Read stdin if piped and not passed in args
if (cmd == "call" && !has_args) {
    let stdin_handle = open("/dev/stdin", "r");
    let stdin_data = stdin_handle ? stdin_handle.read(MAX_RPC_INPUT_BYTES + 1) : null;
    if (stdin_handle) stdin_handle.close();
    if (stdin_data && length(stdin_data) > MAX_RPC_INPUT_BYTES) {
        stdin_too_large = true;
    } else if (stdin_data && length(stdin_data) > 0) {
        args_str = stdin_data;
    }
}

let args = {};
try {
    if (args_str && length(trim(args_str)) > 0) {
        args = json(args_str) || {};
    }
} catch (e) {
    args = {};
}

if (cmd == "call" && stdin_too_large) {
    printf("%.4J\n", { ok: false, error: "RPC request exceeds 1 MiB limit" });
    exit(1);
}

// Paths configuration
const BASE_PROFILES_DIR = mock_dir ? `${mock_dir}/opt/xray/profiles` : (getenv("PROFILES_DIR") || "/opt/xray/profiles");
const TRASH_DIR = `${BASE_PROFILES_DIR}/.trash`;
const LOCK_DIR = `${BASE_PROFILES_DIR}/.lock.d`;
const LOCK_META = `${LOCK_DIR}/meta.json`;
const LOCK_TIMEOUT_SECS = 15;
const XRAY_BIN = mock_dir ? (getenv("XRAY_BIN") || `${mock_dir}/xray`) : (getenv("XRAY_BIN") || "/opt/xray/current/xray");
const ASSET_DIR = mock_dir ? `${mock_dir}/opt/xray/current` : (getenv("XRAY_LOCATION_ASSET") || "/opt/xray/current");
const INIT_SCRIPT = mock_dir ? `${mock_dir}/etc/init.d/xray_profiles` : "/etc/init.d/xray_profiles";
const LEGACY_INIT = mock_dir ? `${mock_dir}/etc/init.d/xray_core` : "/etc/init.d/xray_core";
const UCI_DIR = mock_dir ? `${mock_dir}/etc/config` : null;
const SS_BIN = mock_dir ? `${mock_dir}/usr/sbin/ss` : "/usr/sbin/ss";
const SOCKSTATS_BIN = mock_dir ? `${mock_dir}/usr/libexec/xray-sockstats` : "/usr/libexec/xray-sockstats";
const THERMAL_TEMP_PATH = mock_dir ? `${mock_dir}/sys/class/thermal/thermal_zone0/temp` : "/sys/class/thermal/thermal_zone0/temp";
const THROTTLED_PATH = mock_dir ? `${mock_dir}/sys/devices/platform/soc/soc:firmware/get_throttled` : "/sys/devices/platform/soc/soc:firmware/get_throttled";
const VCGENCMD_BIN = mock_dir ? `${mock_dir}/usr/bin/vcgencmd` : "/usr/bin/vcgencmd";
const PROC_STAT_PATH = mock_dir ? `${mock_dir}/proc/stat` : "/proc/stat";
const VERSION_CACHE_DIR = mock_dir ? `${mock_dir}/.xray-profiles-cache` : "/tmp/xray-profiles-cache";
const VERSION_CACHE_PATH = `${VERSION_CACHE_DIR}/version.json`;
const LINUX_USER_HZ = 100;

// Helpers
function ensure_dirs() {
    mkdir(BASE_PROFILES_DIR, 0700);
    chmod(BASE_PROFILES_DIR, 0700);
    mkdir(TRASH_DIR, 0700);
    chmod(TRASH_DIR, 0700);
}

function current_pid() {
    let proc_stat = readfile("/proc/self/stat");
    if (!proc_stat) return 0;
    let fields = split(trim(proc_stat), " ");
    return int(fields[0] || "0");
}

let temp_counter = 0;

// mkdir() is an atomic exclusive create on every supported ucode/fs version.
// PID, wall clock and a per-process counter keep names unique without randomness.
function make_temp_dir(prefix) {
    ensure_dirs();
    let pid = current_pid();
    if (!pid) return null;

    for (let attempt = 0; attempt < 128; attempt++) {
        temp_counter++;
        let path = `${BASE_PROFILES_DIR}/${prefix}_${pid}_${time()}_${temp_counter}`;
        if (mkdir(path, 0700)) {
            chmod(path, 0700);
            return path;
        }
    }

    return null;
}

// Process runner capturing exact exit code, stdout and stderr
function run_process(cmd_str, max_output_bytes) {
    let tmp_dir = make_temp_dir(".run");
    if (!tmp_dir) {
        return { exit_code: -1, stdout: "", stderr: "Unable to create process capture directory" };
    }
    let tmp_prefix = `${tmp_dir}/run`;
    let out_file = `${tmp_prefix}.out`;
    let err_file = `${tmp_prefix}.err`;
    let rc_file = `${tmp_prefix}.rc`;

    let rc = -1;
    let stdout_content = "";
    let stderr_content = "";

    let process_error = null;
    try {
        let wrapped = `(${cmd_str}) > "${out_file}" 2> "${err_file}"; echo $? > "${rc_file}"`;
        let p = popen(wrapped, "r");
        if (p) {
            p.read("all");
            p.close();
        }

        if (access(rc_file)) {
            rc = int(trim(readfile(rc_file) || "-1"));
        }
        if (access(out_file)) {
            stdout_content = readfile(out_file) || "";
        }
        if (access(err_file)) {
            stderr_content = readfile(err_file) || "";
        }
    } catch (e) {
        process_error = e;
    }
    unlink(rc_file);
    unlink(out_file);
    unlink(err_file);
    rmdir(tmp_dir);
    if (process_error) {
        die(process_error);
    }

    let capture_limit = max_output_bytes || 8192;
    return {
        exit_code: rc,
        stdout: substr(stdout_content, 0, capture_limit),
        stderr: substr(stderr_content, 0, 8192)
    };
}

function run_cmd(command) {
    let res = run_process(command);
    return res.stdout;
}

function parse_hex_uint(value) {
    let input = lc(trim(value || ""));
    let marker = index(input, "0x");
    if (marker >= 0) input = substr(input, marker + 2);
    if (!length(input)) return null;

    let parsed = 0;
    const digits = "0123456789abcdef";
    for (let i = 0; i < length(input); i++) {
        let digit = index(digits, substr(input, i, 1));
        if (digit < 0) return null;
        parsed = parsed * 16 + digit;
    }
    return parsed;
}

function flag_set(value, mask) {
    return value != null && (int(value / mask) % 2) == 1;
}

function get_cpu_ticks() {
    let content = readfile(PROC_STAT_PATH);
    if (!content) return null;
    let line = split(content, "\n")[0] || "";
    let fields = split(trim(line), /[ \t]+/);
    if (length(fields) < 5 || fields[0] != "cpu") return null;

    let total = 0;
    for (let i = 1; i < length(fields); i++) {
        if (!match(fields[i], /^[0-9]+$/)) return null;
        total += int(fields[i]);
    }

    return {
        total: total,
        idle: int(fields[4]) + int(fields[5] || "0")
    };
}

function get_hardware_health() {
    let temperature_millidegrees = null;
    let raw_temperature = readfile(THERMAL_TEMP_PATH);
    if (raw_temperature && match(trim(raw_temperature), /^[-]?[0-9]+$/)) {
        let millidegrees = int(trim(raw_temperature));
        if (millidegrees >= -40000 && millidegrees <= 150000) {
            temperature_millidegrees = millidegrees;
        }
    }

    let throttled_text = readfile(THROTTLED_PATH);
    if (!throttled_text && access(VCGENCMD_BIN, "x")) {
        let handle = popen(`"${VCGENCMD_BIN}" get_throttled 2>/dev/null`, "r");
        if (handle) {
            throttled_text = handle.read(256) || "";
            handle.close();
        }
    }

    let throttled = parse_hex_uint(throttled_text);
    let cpu_ticks = get_cpu_ticks();
    return {
        temperature_available: temperature_millidegrees != null,
        temperature_millidegrees: temperature_millidegrees,
        cpu_available: cpu_ticks != null,
        cpu_total_ticks: cpu_ticks ? cpu_ticks.total : null,
        cpu_idle_ticks: cpu_ticks ? cpu_ticks.idle : null,
        power_status_available: throttled != null,
        undervoltage_now: flag_set(throttled, 1),
        undervoltage_occurred: flag_set(throttled, 65536)
    };
}

function get_binary_version() {
    let binary_stat = stat(XRAY_BIN);
    if (!binary_stat || !access(XRAY_BIN, "x")) return "";

    let signature = `${binary_stat.size || 0}:${binary_stat.mtime || 0}`;
    let cached_text = readfile(VERSION_CACHE_PATH);
    if (cached_text) {
        try {
            let cached = json(cached_text);
            if (cached && cached.signature == signature && cached.version) {
                return cached.version;
            }
        } catch (e) {
            // A partial cache is ignored and replaced atomically below.
        }
    }

    let version_result = run_process(`"${XRAY_BIN}" version`);
    if (version_result.exit_code !== 0) return "";
    let version = split(version_result.stdout, "\n")[0] || "";
    if (!version) return "";

    let cache_dir_stat = lstat(VERSION_CACHE_DIR);
    if (cache_dir_stat && cache_dir_stat.type != "directory") return version;
    if (!cache_dir_stat) mkdir(VERSION_CACHE_DIR, 0700);
    chmod(VERSION_CACHE_DIR, 0700);
    let cache_stat = lstat(VERSION_CACHE_PATH);
    if (cache_stat && cache_stat.type != "file") return version;

    let cache_tmp = `${VERSION_CACHE_PATH}.tmp.${current_pid()}`;
    let cache_handle = open(cache_tmp, "w", 0600);
    if (cache_handle) {
        cache_handle.write(sprintf("%.4J\n", { signature: signature, version: version }));
        cache_handle.close();
        chmod(cache_tmp, 0600);
        rename(cache_tmp, VERSION_CACHE_PATH);
    }
    return version;
}

// Process PID checker
function is_pid_alive(pid) {
    if (!pid || pid <= 0) return false;
    let st = stat(`/proc/${pid}`);
    return st && st.type == "directory";
}

// Mutex Locking with Stale-Lock Detection and Recovery
function acquire_lock() {
    ensure_dirs();
    for (let attempt = 0; attempt < 30; attempt++) {
        if (mkdir(LOCK_DIR, 0700)) {
            let owner_pid = current_pid();
            if (!owner_pid) {
                rmdir(LOCK_DIR);
                return false;
            }
            let meta = { pid: owner_pid, ts: time() };
            let fh = open(LOCK_META, "w", 0600);
            if (!fh) {
                rmdir(LOCK_DIR);
                return false;
            }
            fh.write(sprintf("%.0J", meta));
            fh.close();
            return true;
        }

        // Stale-lock inspection
        let st = stat(LOCK_DIR);
        if (st) {
            let is_stale = false;
            let meta_content = readfile(LOCK_META);
            let meta = null;
            try {
                if (meta_content) meta = json(meta_content);
            } catch (e) {}

            if (meta && meta.ts && (time() - meta.ts > LOCK_TIMEOUT_SECS)) {
                if (!meta.pid || !is_pid_alive(meta.pid)) {
                    is_stale = true;
                }
            } else if (time() - st.mtime > LOCK_TIMEOUT_SECS) {
                is_stale = true;
            }

            if (is_stale) {
                unlink(LOCK_META);
                rmdir(LOCK_DIR);
                continue;
            }
        }

        let p = popen("sleep 0.1 2>/dev/null || sleep 1", "r");
        if (p) p.close();
    }
    return false;
}

function release_lock() {
    unlink(LOCK_META);
    rmdir(LOCK_DIR);
}

function get_uci() {
    let uci_ctx = cursor(UCI_DIR);
    return uci_ctx;
}

function get_procd_instances() {
    let instances = {};
    if (mock_dir) {
        let mock_file = `${mock_dir}/instances.json`;
        if (access(mock_file)) {
            try {
                let data = json(readfile(mock_file) || "{}");
                if (data && data.instances) return data.instances;
                if (data && data.xray_profiles && data.xray_profiles.instances) return data.xray_profiles.instances;
            } catch (e) {}
        }
        return instances;
    }
    let ubus_out = run_cmd("ubus call service list '{\"name\": \"xray_profiles\"}' 2>/dev/null");
    try {
        let parsed = json(ubus_out);
        if (parsed && parsed.xray_profiles && parsed.xray_profiles.instances) {
            instances = parsed.xray_profiles.instances;
        }
    } catch (e) {}
    return instances;
}

function get_process_uptime(pid) {
    if (!pid || pid <= 0) return null;

    let proc_stat = readfile(`/proc/${pid}/stat`);
    let proc_uptime = readfile("/proc/uptime");
    if (!proc_stat || !proc_uptime) return null;

    // Xray's comm field is `(xray)`, so field 22 is stable at array index 21.
    let fields = split(trim(proc_stat), " ");
    let uptime_fields = split(trim(proc_uptime), " ");
    let start_ticks = int(fields[21] || "0");
    let system_uptime = int(uptime_fields[0] || "0");
    if (start_ticks <= 0 || system_uptime < 0) return null;

    let process_uptime = system_uptime - int(start_ticks / LINUX_USER_HZ);
    return process_uptime >= 0 ? process_uptime : null;
}

function empty_traffic_metrics(pid, reason) {
    return {
        available: false,
        bytes_available: false,
        rtt_available: false,
        reason: reason || "unavailable",
        source: "none",
        sample_time: time(),
        pid: pid || null,
        connections: 0,
        rx_bytes: null,
        tx_bytes: null,
        rtt_ms: null,
        uptime_seconds: pid ? get_process_uptime(pid) : null
    };
}

function parse_ss_counter(line, prefix) {
    for (let token in split(trim(line), " ")) {
        if (index(token, prefix) == 0) {
            let raw = substr(token, length(prefix));
            if (prefix == "rtt:") raw = split(raw, "/")[0] || "";
            return int(raw || "0");
        }
    }
    return null;
}

function get_profile_traffic(profiles) {
    let metrics = {};
    let running_profiles = [];

    for (let profile in profiles) {
        let metric = empty_traffic_metrics(profile.pid, profile.running ? "ss_unavailable" : "stopped");
        metrics[profile.id] = metric;
        if (profile.running && profile.pid > 0) push(running_profiles, profile);
    }

    if (length(running_profiles) == 0) return metrics;

    // Tests can provide deterministic TCP_INFO snapshots without touching /proc.
    if (mock_dir) {
        let mock_file = `${mock_dir}/traffic.json`;
        if (access(mock_file, "r")) {
            try {
                let mock_metrics = json(readfile(mock_file) || "{}") || {};
                for (let profile in running_profiles) {
                    let supplied = mock_metrics[profile.id];
                    if (!supplied) continue;
                    let metric = metrics[profile.id];
                    metric.available = supplied.available === false ? false : true;
                    metric.bytes_available = supplied.bytes_available === false ? false : metric.available;
                    metric.rtt_available = supplied.rtt_available === false ? false : supplied.rtt_ms != null;
                    metric.reason = supplied.reason || null;
                    metric.source = supplied.source || "mock_tcp_info";
                    metric.connections = int(supplied.connections || 0);
                    metric.rx_bytes = metric.bytes_available ? int(supplied.rx_bytes || 0) : null;
                    metric.tx_bytes = metric.bytes_available ? int(supplied.tx_bytes || 0) : null;
                    metric.rtt_ms = supplied.rtt_ms == null ? null : int(supplied.rtt_ms);
                    metric.uptime_seconds = supplied.uptime_seconds == null ? null : int(supplied.uptime_seconds);
                    metric.sample_time = int(supplied.sample_time || time());
                }
            } catch (e) {}
            return metrics;
        }
    }

    // Prefer direct getsockopt(TCP_INFO) reads from duplicated process FDs.
    // This avoids relying on optional fields in iproute2's text output while
    // keeping observability read-only and free of Xray API/listeners.
    if (access(SOCKSTATS_BIN, "x")) {
        let helper_args = [];
        for (let profile in running_profiles) push(helper_args, sprintf("%d", profile.pid));
        let helper_result = run_process(`"${SOCKSTATS_BIN}" ${join(" ", helper_args)}`, 262144);
        if (helper_result.exit_code === 0) {
            try {
                let helper_metrics = json(helper_result.stdout || "{}") || {};
                let complete = true;
                for (let profile in running_profiles) {
                    let supplied = helper_metrics[`${profile.pid}`];
                    if (!supplied || supplied.available !== true) {
                        complete = false;
                        break;
                    }

                    let metric = metrics[profile.id];
                    metric.available = true;
                    metric.bytes_available = supplied.bytes_available === true;
                    metric.rtt_available = supplied.rtt_available === true;
                    metric.reason = metric.bytes_available ? null : "tcp_info_fields_unavailable";
                    metric.source = "pidfd_tcp_info";
                    metric.connections = int(supplied.connections || 0);
                    metric.rx_bytes = metric.bytes_available ? int(supplied.rx_bytes || 0) : null;
                    metric.tx_bytes = metric.bytes_available ? int(supplied.tx_bytes || 0) : null;
                    metric.rtt_ms = metric.rtt_available && supplied.rtt_ms != null ? int(supplied.rtt_ms) : null;
                }
                if (complete) return metrics;
            } catch (e) {}
        }
    }

    if (!access(SS_BIN, "x")) return metrics;

    // One bounded snapshot serves every profile. TCP_INFO requires no Xray API,
    // listener, profile mutation, probe packet, or external host access.
    let ss_result = run_process(`"${SS_BIN}" -tinpH`, 262144);
    if (ss_result.exit_code !== 0) {
        for (let profile in running_profiles) metrics[profile.id].reason = "ss_failed";
        return metrics;
    }

    for (let profile in running_profiles) {
        metrics[profile.id].available = true;
        metrics[profile.id].source = "ss_tcp_info";
        metrics[profile.id].reason = "tcp_info_fields_unavailable";
    }

    let selected_profile = null;
    let rtt_sum = {};
    let rtt_count = {};
    let counter_count = {};

    for (let line in split(ss_result.stdout, "\n")) {
        if (!line || length(line) == 0) continue;

        if (!match(line, /^[ \t]/)) {
            selected_profile = null;
            for (let profile in running_profiles) {
                if (index(line, `pid=${profile.pid},`) >= 0) {
                    selected_profile = profile.id;
                    metrics[selected_profile].connections++;
                    break;
                }
            }
        }

        if (!selected_profile) continue;
        let rx_bytes = parse_ss_counter(line, "bytes_received:");
        let tx_bytes = parse_ss_counter(line, "bytes_sent:");
        let rtt_ms = parse_ss_counter(line, "rtt:");
        if (rx_bytes != null || tx_bytes != null) {
            metrics[selected_profile].rx_bytes = int(metrics[selected_profile].rx_bytes || 0) + int(rx_bytes || 0);
            metrics[selected_profile].tx_bytes = int(metrics[selected_profile].tx_bytes || 0) + int(tx_bytes || 0);
            counter_count[selected_profile] = (counter_count[selected_profile] || 0) + 1;
        }
        if (rtt_ms != null) {
            rtt_sum[selected_profile] = (rtt_sum[selected_profile] || 0) + rtt_ms;
            rtt_count[selected_profile] = (rtt_count[selected_profile] || 0) + 1;
        }
    }

    for (let profile in running_profiles) {
        let count = rtt_count[profile.id] || 0;
        let metric = metrics[profile.id];
        if (count > 0) {
            metric.rtt_available = true;
            metric.rtt_ms = int(rtt_sum[profile.id] / count);
        }
        if ((counter_count[profile.id] || 0) > 0 || metric.connections == 0) {
            metric.bytes_available = true;
            metric.rx_bytes = int(metric.rx_bytes || 0);
            metric.tx_bytes = int(metric.tx_bytes || 0);
            metric.reason = null;
        }
    }

    return metrics;
}

function get_profile_stack(filepath) {
    let content = readfile(filepath);
    if (!content) return null;

    let parsed = null;
    try {
        parsed = json(content);
    } catch (e) {
        return null;
    }

    if (!parsed || type(parsed.outbounds) != "array") return null;

    let descriptions = [];
    for (let outbound in parsed.outbounds) {
        if (!outbound || outbound.protocol != "vless" || !outbound.settings ||
            !outbound.settings.reverse || !outbound.settings.reverse.tag) continue;

        let parts = [ "VLESS" ];
        let stream = outbound.streamSettings || {};
        // Modern Reverse exports may call the transport selector "method"
        // while conventional Xray JSON uses "network".
        let network = stream.network || stream.method || "";
        let security = stream.security || "";
        let flow = outbound.settings.flow || "";

        if (network == "grpc") push(parts, "gRPC");
        else if (network == "xhttp" || network == "splithttp") push(parts, "XHTTP");
        else if (network == "ws") push(parts, "WebSocket");
        else if (network == "http" || network == "h2") push(parts, "HTTP/2");
        else if (network == "httpupgrade") push(parts, "HTTP Upgrade");
        else if (network == "quic") push(parts, "QUIC");
        else if (network == "kcp" || network == "mkcp") push(parts, "mKCP");
        else if (network && network != "tcp" && network != "raw") push(parts, network);

        if (security == "reality") push(parts, "REALITY");
        else if (security == "tls") push(parts, "TLS");
        else if (security && security != "none") push(parts, security);

        if (flow == "xtls-rprx-vision") push(parts, "Vision");
        else if (flow) push(parts, flow);

        push(descriptions, join(" + ", parts));
    }

    return length(descriptions) > 0 ? join(" / ", descriptions) : null;
}

// Bounded polling state machine for process lifecycle
function poll_instance_state(id, expected_running, max_wait_ms) {
    let max_ms = max_wait_ms || 3000;
    let step = 100;
    let attempts = int(max_ms / step);
    if (attempts < 1) attempts = 1;

    for (let i = 0; i < attempts; i++) {
        let inst = get_procd_instances();
        let target = inst[`profile_${id}`];
        let is_running = (target && target.running && target.pid > 0);
        if (expected_running) {
            if (is_running) {
                return { ok: true, running: true, pid: target.pid, respawn_count: target.respawn_count || 0 };
            }
        } else {
            if (!target || !target.running) {
                return { ok: true, running: false, pid: null };
            }
        }
        let p = popen("sleep 0.1 2>/dev/null || sleep 1", "r");
        if (p) p.close();
    }

    let final_inst = get_procd_instances();
    let final_target = final_inst[`profile_${id}`];
    let final_running = (final_target && final_target.running && final_target.pid > 0);
    return {
        ok: expected_running ? (final_running ? true : false) : (!final_running ? true : false),
        running: final_running ? true : false,
        pid: final_target ? final_target.pid : null,
        respawn_count: final_target ? (final_target.respawn_count || 0) : 0
    };
}

// Validation Helpers & Strict Whitelist
function is_valid_id(id) {
    if (!id || length(id) == 0 || length(id) > 64) return false;
    return match(id, /^[a-zA-Z0-9_-]+$/) ? true : false;
}

function is_valid_name(str) {
    if (!str || length(str) == 0 || length(str) > 64) return false;
    return match(str, /^[a-zA-Z0-9_ -]+$/) ? true : false;
}

function is_valid_filename(fn) {
    if (!fn || length(fn) < 6 || length(fn) > 64) return false;
    if (index(fn, "/") >= 0 || index(fn, "\\") >= 0 || index(fn, "..") >= 0) return false;
    return match(fn, /^[a-zA-Z0-9_-]+\.json$/) ? true : false;
}

function sanitize_id(str) {
    let clean = replace(str, /[^a-zA-Z0-9_]/g, "_");
    if (!clean || length(clean) == 0) clean = `profile_${time()}`;
    return clean;
}

function scan_geodata_requirements(value, requirements) {
    let value_type = type(value);

    if (value_type == "string") {
        if (index(value, "geoip:") >= 0) requirements.requires_geoip = true;
        if (index(value, "geosite:") >= 0) requirements.requires_geosite = true;
    } else if (value_type == "array") {
        for (let item in value) {
            scan_geodata_requirements(item, requirements);
        }
    } else if (value_type == "object") {
        for (let item in values(value)) {
            scan_geodata_requirements(item, requirements);
        }
    }
}

function get_profile_geodata(filepath) {
    let requirements = {
        requires_geoip: false,
        requires_geosite: false,
        geoip_found: false,
        geosite_found: false,
        missing: []
    };

    if (access(filepath, "r")) {
        try {
            scan_geodata_requirements(json(readfile(filepath) || "{}"), requirements);
        } catch (e) {}
    }

    requirements.geoip_found = access(`${ASSET_DIR}/geoip.dat`, "r") || access("/usr/share/xray/geoip.dat", "r") ? true : false;
    requirements.geosite_found = access(`${ASSET_DIR}/geosite.dat`, "r") || access("/usr/share/xray/geosite.dat", "r") ? true : false;

    if (requirements.requires_geoip && !requirements.geoip_found) push(requirements.missing, "geoip.dat");
    if (requirements.requires_geosite && !requirements.geosite_found) push(requirements.missing, "geosite.dat");

    return requirements;
}

// Reverse Profile Policy Check
function validate_policy(json_obj) {
    if (!json_obj || type(json_obj) != "object") {
        return { ok: false, error: "Invalid JSON root object" };
    }

    // Inbounds policy: must be absent or empty array
    if (json_obj.inbounds) {
        if (type(json_obj.inbounds) != "array" || length(json_obj.inbounds) > 0) {
            return { ok: false, error: "Policy violation: listening inbounds are prohibited in Reverse Profile mode" };
        }
    }

    // Check for API, metrics, or stats listeners
    if (json_obj.api || json_obj.metrics || json_obj.stats) {
        return { ok: false, error: "Policy violation: API/metrics listeners are prohibited in Reverse Profile mode" };
    }

    // Check for legacy bridges
    if (json_obj.reverse && json_obj.reverse.bridges) {
        return { ok: false, error: "Policy violation: legacy reverse.bridges is prohibited; use modern VLESS reverse tag" };
    }

    // Check for modern VLESS settings.reverse.tag
    let has_modern_reverse = false;
    if (type(json_obj.outbounds) == "array") {
        for (let ob in json_obj.outbounds) {
            if (ob.protocol == "vless" && ob.settings && ob.settings.reverse && ob.settings.reverse.tag) {
                if (length(trim(ob.settings.reverse.tag)) > 0) {
                    has_modern_reverse = true;
                }
            }
        }
    }

    if (!has_modern_reverse) {
        return { ok: false, error: "Policy violation: at least one VLESS outbound must contain settings.reverse.tag" };
    }

    return { ok: true };
}

function validate_content_full(content_str) {
    if (!content_str || length(content_str) == 0) {
        return { ok: false, error: "Profile content is empty" };
    }
    if (length(content_str) > 524288) {
        return { ok: false, error: "Profile size exceeds 512 KiB limit" };
    }

    let parsed = null;
    try {
        parsed = json(content_str);
    } catch (e) {
        return { ok: false, error: "Invalid JSON syntax" };
    }

    let pol = validate_policy(parsed);
    if (!pol.ok) {
        return pol;
    }

    // Binary existence check - hard failure if missing or non-executable
    if (!access(XRAY_BIN, "x")) {
        return { ok: false, error: "Xray runtime binary missing or not executable" };
    }

    // Write to temporary file with mode 0600 created before writing
    ensure_dirs();
    let tmp_dir = make_temp_dir(".tmp_test");
    if (!tmp_dir) {
        return { ok: false, error: "Failed to create exclusive temporary directory for validation" };
    }
    let tmp_path = `${tmp_dir}/config.json`;
    let fh = open(tmp_path, "w", 0600);
    if (!fh) {
        rmdir(tmp_dir);
        return { ok: false, error: "Failed to open temporary file with mode 0600 for validation" };
    }
    let run_res = null;
    let validation_error = null;
    try {
        fh.write(content_str);
        fh.close();
        fh = null;
        chmod(tmp_path, 0600);

        let test_cmd = `XRAY_LOCATION_ASSET="${ASSET_DIR}" "${XRAY_BIN}" run -test -config "${tmp_path}"`;
        run_res = run_process(test_cmd);
    } catch (e) {
        validation_error = e;
    }
    if (fh) fh.close();
    unlink(tmp_path);
    rmdir(tmp_dir);
    if (validation_error) {
        die(validation_error);
    }

    if (run_res.exit_code !== 0) {
        return { ok: false, error: `Xray configuration validation test failed (exit code ${run_res.exit_code})` };
    }

    return { ok: true };
}

