function rpc_list() {
    ensure_dirs();
    let u = get_uci();
    let profiles = [];
    let instances = get_procd_instances();

    u.load("xray_core");
    u.foreach("xray_core", "profile", function(s) {
        let id = s[".name"];
        let filename = s.filename || `${id}.json`;
        let filepath = `${BASE_PROFILES_DIR}/${filename}`;
        let st = stat(filepath);
        let exists = st ? true : false;
        let instance_key = `profile_${id}`;
        let inst = instances[instance_key] || {};
        let is_running = (inst.running && inst.pid > 0) ? true : false;
        let pid = is_running ? inst.pid : null;

        push(profiles, {
            id: id,
            name: s.name || id,
            filename: filename,
            order: int(s.order) || 0,
            autostart: s.autostart == "1",
            exists: exists,
            running: is_running,
            pid: pid,
            respawn_count: int(inst.respawn_count || 0),
            last_error: null,
            geodata: get_profile_geodata(filepath),
            protocol_stack: get_profile_stack(filepath)
        });
    });

    let traffic = get_profile_traffic(profiles);
    for (let profile in profiles) profile.traffic = traffic[profile.id];

    // Check system status
    let bin_found = access(XRAY_BIN, "x") ? true : false;
    let bin_ver = "";
    if (bin_found) {
        bin_ver = get_binary_version();
    }

    let running_cnt = 0;
    let failed_cnt = 0;
    for (let p in profiles) {
        if (p.running) {
            running_cnt++;
        } else {
            let inst = instances[`profile_${p.id}`];
            if (inst && (inst.running === false || inst.running === 0) && inst.respawn_count && inst.respawn_count > 0) {
                failed_cnt++;
            }
        }
    }

    let service_enabled = false;
    if (access(INIT_SCRIPT)) {
        let en_res = run_process(`"${INIT_SCRIPT}" enabled 2>&1`);
        service_enabled = (en_res.exit_code === 0);
    }

    let legacy_running = false;
    let legacy_ubus = run_cmd("ubus call service list '{\"name\": \"xray_core\"}' 2>/dev/null");
    if (index(legacy_ubus, '"running": true') >= 0 || index(legacy_ubus, '"running":true') >= 0) {
        legacy_running = true;
    }

    return {
        ok: true,
        profiles: profiles,
        summary: {
            binary_path: XRAY_BIN,
            binary_found: bin_found,
            binary_version: bin_ver,
            stored_count: length(profiles),
            running_count: running_cnt,
            failed_count: failed_cnt,
            service_enabled: service_enabled,
            legacy_running: legacy_running,
            hardware: get_hardware_health()
        }
    };
}

function rpc_validate(params) {
    let content = params.content;
    return validate_content_full(content);
}

function rpc_import(params) {
    let name = trim(params.name || "");
    let filename = trim(params.filename || "");
    let content = params.content || "";
    let autostart = params.autostart ? "1" : "0";

    if (!is_valid_name(name)) {
        return { ok: false, error: "Invalid profile name" };
    }
    if (!is_valid_filename(filename)) {
        return { ok: false, error: "Invalid canonical filename (must match ^[a-zA-Z0-9_-]+\\.json$)" };
    }

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let val = validate_content_full(content);
        if (!val.ok) {
            release_lock();
            return val;
        }

        ensure_dirs();
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;

        // Reject existing symlinks using real lstat check
        let target_lst = lstat(target_path);
        if (target_lst && target_lst.type == "link") {
            release_lock();
            return { ok: false, error: "Target destination is a symbolic link; replacement forbidden" };
        }

        let id = sanitize_id(replace(filename, /\.json$/i, ""));
        if (!is_valid_id(id)) {
            release_lock();
            return { ok: false, error: "Generated profile ID is invalid" };
        }

        let u = get_uci();
        u.load("xray_core");

        // Check duplicate ID or filename
        let exists_in_uci = false;
        u.foreach("xray_core", "profile", function(s) {
            if (s[".name"] == id || s.filename == filename) {
                exists_in_uci = true;
            }
        });

        if (exists_in_uci) {
            release_lock();
            return { ok: false, error: `Profile with ID '${id}' or filename '${filename}' already exists in configuration` };
        }

        // Orphan regular file check: if file exists on disk but not registered in UCI, reject to prevent silent overwrite
        if (access(target_path) && !exists_in_uci) {
            release_lock();
            return { ok: false, error: `Unmanaged orphan file '${filename}' already exists at destination; import rejected` };
        }

        // Write to temporary file created with mode 0600 BEFORE content write
        let tmp_dir = make_temp_dir(".tmp_import");
        if (!tmp_dir) {
            release_lock();
            return { ok: false, error: "Failed to create exclusive temporary directory for import" };
        }
        let tmp_path = `${tmp_dir}/config.json`;
        let fh = open(tmp_path, "w", 0600);
        if (!fh) {
            rmdir(tmp_dir);
            release_lock();
            return { ok: false, error: "Failed to open temporary file with mode 0600" };
        }
        let installed = false;
        let install_error = null;
        try {
            fh.write(content);
            fh.close();
            fh = null;
            chmod(tmp_path, 0600);

            // Atomically rename into place
            installed = rename(tmp_path, target_path) ? true : false;
        } catch (e) {
            install_error = e;
        }
        if (fh) fh.close();
        unlink(tmp_path);
        rmdir(tmp_dir);
        if (install_error) {
            die(install_error);
        }
        if (!installed) {
            release_lock();
            return { ok: false, error: "Failed to atomically install profile file" };
        }
        chmod(target_path, 0600);

        // Add a named UCI section using the ucode cursor API available on all
        // supported OpenWrt releases, then populate its options explicitly.
        let metadata_ok = u.set("xray_core", id, "profile");
        if (metadata_ok) metadata_ok = u.set("xray_core", id, "name", name);
        if (metadata_ok) metadata_ok = u.set("xray_core", id, "filename", filename);
        if (metadata_ok) metadata_ok = u.set("xray_core", id, "order", "0");
        if (metadata_ok) metadata_ok = u.set("xray_core", id, "autostart", autostart);
        if (metadata_ok) metadata_ok = u.commit("xray_core");

        if (!metadata_ok) {
            u.revert("xray_core");
            unlink(target_path);
            release_lock();
            return { ok: false, error: "Failed to persist profile metadata" };
        }

        if (autostart == "1" && access(INIT_SCRIPT)) {
            run_cmd(`"${INIT_SCRIPT}" start "${id}" >/dev/null 2>&1`);
        }

        release_lock();
        return { ok: true, id: id, filename: filename };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Import failed: ${e}` };
    }
}

function rpc_replace(params) {
    let id = trim(params.id || "");
    let content = params.content || "";

    if (!is_valid_id(id)) {
        return { ok: false, error: "Invalid profile ID" };
    }

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let u = get_uci();
        u.load("xray_core");
        let profile_sec = u.get_all("xray_core", id);
        if (!profile_sec || profile_sec[".type"] != "profile") {
            release_lock();
            return { ok: false, error: `Profile '${id}' not found` };
        }

        let val = validate_content_full(content);
        if (!val.ok) {
            release_lock();
            return val;
        }

        let filename = profile_sec.filename || `${id}.json`;
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;
        let tmp_dir = make_temp_dir(".tmp_replace");
        if (!tmp_dir) {
            release_lock();
            return { ok: false, error: "Failed to create exclusive temporary directory for replacement" };
        }
        let backup_path = `${tmp_dir}/backup.json`;
        let tmp_path = `${tmp_dir}/config.json`;

        ensure_dirs();

        // Reject existing symlinks using real lstat check
        let target_lst = lstat(target_path);
        if (target_lst && target_lst.type == "link") {
            rmdir(tmp_dir);
            release_lock();
            return { ok: false, error: "Target destination is a symbolic link; replacement forbidden" };
        }

        // Check running state
        let instances = get_procd_instances();
        let was_running = (instances[`profile_${id}`] && instances[`profile_${id}`].running) ? true : false;

        // Backup previous valid file
        if (access(target_path)) {
            rename(target_path, backup_path);
        }

        // Write new content to tmp file with mode 0600 and atomically rename
        let fh = open(tmp_path, "w", 0600);
        if (!fh) {
            if (access(backup_path)) rename(backup_path, target_path);
            rmdir(tmp_dir);
            release_lock();
            return { ok: false, error: "Failed to open temporary file with mode 0600" };
        }
        let replacement_error = null;
        let replacement_exception = null;
        try {
            fh.write(content);
            fh.close();
            fh = null;
            chmod(tmp_path, 0600);

            if (!rename(tmp_path, target_path)) {
                if (access(backup_path)) {
                    rename(backup_path, target_path);
                }
                replacement_error = "Failed to atomically replace profile file";
            } else {
                chmod(target_path, 0600);

                // If was running, restart instance with bounded verification
                if (was_running && access(INIT_SCRIPT, "x")) {
                    run_cmd(`"${INIT_SCRIPT}" restart "${id}" 2>&1`);
                    let poll = poll_instance_state(id, true, 3000);
                    if (!poll.ok || !poll.running) {
                        // Rollback on restart failure
                        if (access(backup_path)) {
                            unlink(target_path);
                            rename(backup_path, target_path);
                            run_cmd(`"${INIT_SCRIPT}" restart "${id}" >/dev/null 2>&1`);
                        }
                        replacement_error = "Restart failed on replacement; rolled back to previous valid profile";
                    }
                }
            }
        } catch (e) {
            replacement_exception = e;
        }
        if (fh) fh.close();
        unlink(tmp_path);
        unlink(backup_path);
        rmdir(tmp_dir);
        if (replacement_exception) {
            die(replacement_exception);
        }
        if (replacement_error) {
            release_lock();
            return { ok: false, error: replacement_error };
        }

        release_lock();
        return { ok: true };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Replace failed: ${e}` };
    }
}

function rpc_delete(params) {
    let id = trim(params.id || "");
    let purge = params.purge ? true : false;
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let u = get_uci();
        u.load("xray_core");
        let profile_sec = u.get_all("xray_core", id);
        if (!profile_sec) {
            release_lock();
            return { ok: false, error: `Profile '${id}' not found` };
        }

        let filename = profile_sec.filename || `${id}.json`;
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;

        // Stop procd instance
        if (access(INIT_SCRIPT)) {
            run_cmd(`"${INIT_SCRIPT}" stop "${id}" >/dev/null 2>&1`);
        }

        // Move file to .trash/
        ensure_dirs();
        let target_lst = lstat(target_path);
        if (target_lst) {
            if (target_lst.type == "link") {
                unlink(target_path);
            } else if (access(target_path)) {
                if (purge) {
                    if (!unlink(target_path)) {
                        release_lock();
                        return { ok: false, error: "Failed to remove profile file" };
                    }
                } else {
                    let trash_dest = `${TRASH_DIR}/${time()}_${filename}`;
                    if (!rename(target_path, trash_dest)) {
                        release_lock();
                        return { ok: false, error: "Failed to archive profile file into .trash/" };
                    }
                    chmod(trash_dest, 0600);
                }
            }
        }

        u.delete("xray_core", id);
        u.commit("xray_core");

        release_lock();
        return { ok: true };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Delete failed: ${e}` };
    }
}

function rpc_start(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get_all("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found in configuration` };
    }

    let filename = profile_sec.filename || `${id}.json`;
    let filepath = `${BASE_PROFILES_DIR}/${filename}`;
    if (!access(filepath)) {
        return { ok: false, error: `Profile file '${filename}' missing from storage` };
    }

    let res = run_process(`"${INIT_SCRIPT}" start "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service start" };
    }

    let poll = poll_instance_state(id, true, 3000);
    if (poll.ok && poll.running && poll.pid > 0) {
        return { ok: true, running: true, pid: poll.pid };
    } else {
        return { ok: false, error: "Profile failed to start or exited immediately" };
    }
}

function rpc_stop(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let res = run_process(`"${INIT_SCRIPT}" stop "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service stop" };
    }

    let poll = poll_instance_state(id, false, 3000);
    if (!poll.ok && poll.running) {
        return { ok: false, error: "Profile failed to stop within timeout" };
    }
    return { ok: true, running: false };
}

function rpc_restart(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get_all("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found in configuration` };
    }

    let filename = profile_sec.filename || `${id}.json`;
    let filepath = `${BASE_PROFILES_DIR}/${filename}`;
    if (!access(filepath)) {
        return { ok: false, error: `Profile file '${filename}' missing from storage` };
    }

    let res = run_process(`"${INIT_SCRIPT}" restart "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service restart" };
    }

    let poll = poll_instance_state(id, true, 3000);
    if (poll.ok && poll.running && poll.pid > 0) {
        return { ok: true, running: true, pid: poll.pid };
    } else {
        return { ok: false, error: "Profile failed to restart or exited immediately" };
    }
}

function rpc_set_autostart(params) {
    let id = trim(params.id || "");
    let autostart = params.autostart ? "1" : "0";
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get_all("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    u.set("xray_core", id, "autostart", autostart);
    u.commit("xray_core");
    return { ok: true };
}

function rpc_rename(params) {
    let id = trim(params.id || "");
    let name = trim(params.name || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };
    if (!is_valid_name(name)) return { ok: false, error: "Invalid profile name" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get_all("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    u.set("xray_core", id, "name", name);
    u.commit("xray_core");
    return { ok: true };
}

function rpc_reorder(params) {
    let id = trim(params.id || "");
    let direction = trim(params.direction || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get_all("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    let current_order = int(u.get("xray_core", id, "order") || "0");
    if (direction == "up") {
        current_order = current_order > 0 ? current_order - 1 : 0;
    } else if (direction == "down") {
        current_order = current_order + 1;
    }
    u.set("xray_core", id, "order", sprintf("%d", current_order));
    u.commit("xray_core");
    return { ok: true, order: current_order };
}

function rpc_enable_service() {
    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }
    let res = run_process(`"${INIT_SCRIPT}" enable 2>&1`);
    return { ok: res.exit_code === 0 };
}

function rpc_disable_service() {
    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }
    let res = run_process(`"${INIT_SCRIPT}" disable 2>&1`);
    return { ok: res.exit_code === 0 };
}

function rpc_disable_legacy() {
    if (access(LEGACY_INIT)) {
        run_process(`"${LEGACY_INIT}" disable 2>&1`);
        run_process(`"${LEGACY_INIT}" stop 2>&1`);
    }
    return { ok: true };
}

function rpc_diagnostic() {
    let l = rpc_list();
    return { ok: true, summary: l.summary };
}

