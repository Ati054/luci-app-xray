#!/usr/bin/ucode
"use strict";

import { readfile, writefile, open, stat, lstat, access, rename, unlink, chmod, mkdir, rmdir, glob, popen } from "fs";
import { cursor } from "uci";

// Parse CLI flags and arguments
let mock_dir = null;
let cmd = null;
let method = null;
let args_str = "{}";

for (let i = 0; i < length(ARGV); i++) {
    if (ARGV[i] == "--mock-dir" && i + 1 < length(ARGV)) {
        mock_dir = ARGV[++i];
    } else if (!cmd) {
        cmd = ARGV[i];
    } else if (!method) {
        method = ARGV[i];
    } else if (!args_str || args_str == "{}") {
        args_str = ARGV[i];
    }
}

// Read stdin if piped and not passed in args
if (cmd == "call" && (!args_str || args_str == "{}")) {
    let stdin_data = readfile("/dev/stdin");
    if (stdin_data && length(stdin_data) > 0) {
        args_str = stdin_data;
    }
}

let args = {};
try {
    if (args_str && length(trim(args_str)) > 0) {
        args = json(args_str) || {};
    }
} catch (e) {
    args = {};
}

// Paths configuration
const BASE_PROFILES_DIR = mock_dir ? `${mock_dir}/opt/xray/profiles` : (getenv("PROFILES_DIR") || "/opt/xray/profiles");
const TRASH_DIR = `${BASE_PROFILES_DIR}/.trash`;
const LOCK_DIR = `${BASE_PROFILES_DIR}/.lock.d`;
const LOCK_META = `${LOCK_DIR}/meta.json`;
const LOCK_TIMEOUT_SECS = 15;
const XRAY_BIN = mock_dir ? (getenv("XRAY_BIN") || `${mock_dir}/xray`) : (getenv("XRAY_BIN") || "/opt/xray/current/xray");
const ASSET_DIR = mock_dir ? `${mock_dir}/opt/xray/current` : (getenv("XRAY_LOCATION_ASSET") || "/opt/xray/current");
const INIT_SCRIPT = mock_dir ? `${mock_dir}/etc/init.d/xray_profiles` : "/etc/init.d/xray_profiles";
const LEGACY_INIT = mock_dir ? `${mock_dir}/etc/init.d/xray_core` : "/etc/init.d/xray_core";
const UCI_DIR = mock_dir ? `${mock_dir}/etc/config` : null;

// Helpers
function ensure_dirs() {
    mkdir(BASE_PROFILES_DIR, 0700);
    chmod(BASE_PROFILES_DIR, 0700);
    mkdir(TRASH_DIR, 0700);
    chmod(TRASH_DIR, 0700);
}

// Process runner capturing exact exit code, stdout and stderr
function run_process(cmd_str) {
    ensure_dirs();
    let tmp_prefix = `${BASE_PROFILES_DIR}/.run_${time()}_${int(rand() * 100000)}`;
    let out_file = `${tmp_prefix}.out`;
    let err_file = `${tmp_prefix}.err`;
    let rc_file = `${tmp_prefix}.rc`;

    let wrapped = `(${cmd_str}) > "${out_file}" 2> "${err_file}"; echo $? > "${rc_file}"`;
    let p = popen(wrapped, "r");
    if (p) {
        p.read("all");
        p.close();
    }

    let rc = -1;
    let stdout_content = "";
    let stderr_content = "";

    if (access(rc_file)) {
        rc = int(trim(readfile(rc_file) || "-1"));
        unlink(rc_file);
    }
    if (access(out_file)) {
        stdout_content = readfile(out_file) || "";
        unlink(out_file);
    }
    if (access(err_file)) {
        stderr_content = readfile(err_file) || "";
        unlink(err_file);
    }

    return {
        exit_code: rc,
        stdout: substr(stdout_content, 0, 8192),
        stderr: substr(stderr_content, 0, 8192)
    };
}

function run_cmd(command) {
    let res = run_process(command);
    return res.stdout;
}

// Process PID checker
function is_pid_alive(pid) {
    if (!pid || pid <= 0) return false;
    let st = stat(`/proc/${pid}`);
    return st && st.type == "directory";
}

// Mutex Locking with Stale-Lock Detection and Recovery
function acquire_lock() {
    ensure_dirs();
    for (let attempt = 0; attempt < 30; attempt++) {
        if (mkdir(LOCK_DIR, 0700)) {
            let meta = { pid: 0, ts: time() };
            let fh = open(LOCK_META, "w", 0600);
            if (fh) {
                fh.write(sprintf("%.0J", meta));
                fh.close();
            }
            return true;
        }

        // Stale-lock inspection
        let st = stat(LOCK_DIR);
        if (st) {
            let is_stale = false;
            let meta_content = readfile(LOCK_META);
            let meta = null;
            try {
                if (meta_content) meta = json(meta_content);
            } catch (e) {}

            if (meta && meta.ts && (time() - meta.ts > LOCK_TIMEOUT_SECS)) {
                if (!meta.pid || !is_pid_alive(meta.pid)) {
                    is_stale = true;
                }
            } else if (time() - st.mtime > LOCK_TIMEOUT_SECS) {
                is_stale = true;
            }

            if (is_stale) {
                unlink(LOCK_META);
                rmdir(LOCK_DIR);
                continue;
            }
        }

        let p = popen("sleep 0.1 2>/dev/null || sleep 1", "r");
        if (p) p.close();
    }
    return false;
}

function release_lock() {
    unlink(LOCK_META);
    rmdir(LOCK_DIR);
}

function get_sha256(content_or_file, is_file) {
    let cmd_str = is_file ? `sha256sum "${content_or_file}" 2>/dev/null` : `printf '%s' "${content_or_file}" | sha256sum 2>/dev/null`;
    let out = run_cmd(cmd_str);
    let parts = split(trim(out), " ");
    return parts[0] || "";
}

function get_uci() {
    let uci_ctx = cursor(UCI_DIR);
    return uci_ctx;
}

function get_procd_instances() {
    let instances = {};
    if (mock_dir) {
        let mock_file = `${mock_dir}/instances.json`;
        if (access(mock_file)) {
            try {
                let data = json(readfile(mock_file) || "{}");
                if (data && data.instances) return data.instances;
                if (data && data.xray_profiles && data.xray_profiles.instances) return data.xray_profiles.instances;
            } catch (e) {}
        }
        return instances;
    }
    let ubus_out = run_cmd("ubus call service list '{\"name\": \"xray_profiles\"}' 2>/dev/null");
    try {
        let parsed = json(ubus_out);
        if (parsed && parsed.xray_profiles && parsed.xray_profiles.instances) {
            instances = parsed.xray_profiles.instances;
        }
    } catch (e) {}
    return instances;
}

// Bounded polling state machine for process lifecycle
function poll_instance_state(id, expected_running, max_wait_ms) {
    let max_ms = max_wait_ms || 3000;
    let step = 100;
    let attempts = int(max_ms / step);
    if (attempts < 1) attempts = 1;

    for (let i = 0; i < attempts; i++) {
        let inst = get_procd_instances();
        let target = inst[`profile_${id}`];
        let is_running = (target && target.running && target.pid > 0);
        if (expected_running) {
            if (is_running) {
                return { ok: true, running: true, pid: target.pid, respawn_count: target.respawn_count || 0 };
            }
        } else {
            if (!target || !target.running) {
                return { ok: true, running: false, pid: null };
            }
        }
        let p = popen("sleep 0.1 2>/dev/null || sleep 1", "r");
        if (p) p.close();
    }

    let final_inst = get_procd_instances();
    let final_target = final_inst[`profile_${id}`];
    let final_running = (final_target && final_target.running && final_target.pid > 0);
    return {
        ok: expected_running ? (final_running ? true : false) : (!final_running ? true : false),
        running: final_running ? true : false,
        pid: final_target ? final_target.pid : null,
        respawn_count: final_target ? (final_target.respawn_count || 0) : 0
    };
}

// Validation Helpers & Strict Whitelist
function is_valid_id(id) {
    if (!id || length(id) == 0 || length(id) > 64) return false;
    return match(id, /^[a-zA-Z0-9_-]+$/) ? true : false;
}

function is_valid_name(str) {
    if (!str || length(str) == 0 || length(str) > 64) return false;
    return match(str, /^[a-zA-Z0-9_ -]+$/) ? true : false;
}

function is_valid_filename(fn) {
    if (!fn || length(fn) < 6 || length(fn) > 64) return false;
    if (index(fn, "/") >= 0 || index(fn, "\\") >= 0 || index(fn, "..") >= 0) return false;
    return match(fn, /^[a-zA-Z0-9_-]+\.json$/) ? true : false;
}

function sanitize_id(str) {
    let clean = replace(str, /[^a-zA-Z0-9_]/g, "_");
    if (!clean || length(clean) == 0) clean = `profile_${time()}`;
    return clean;
}

// Reverse Profile Policy Check
function validate_policy(json_obj) {
    if (!json_obj || type(json_obj) != "object") {
        return { ok: false, error: "Invalid JSON root object" };
    }

    // Inbounds policy: must be absent or empty array
    if (json_obj.inbounds) {
        if (!is_array(json_obj.inbounds) || length(json_obj.inbounds) > 0) {
            return { ok: false, error: "Policy violation: listening inbounds are prohibited in Reverse Profile mode" };
        }
    }

    // Check for API, metrics, or stats listeners
    if (json_obj.api || json_obj.metrics || json_obj.stats) {
        return { ok: false, error: "Policy violation: API/metrics listeners are prohibited in Reverse Profile mode" };
    }

    // Check for legacy bridges
    if (json_obj.reverse && json_obj.reverse.bridges) {
        return { ok: false, error: "Policy violation: legacy reverse.bridges is prohibited; use modern VLESS reverse tag" };
    }

    // Check for modern VLESS settings.reverse.tag
    let has_modern_reverse = false;
    if (is_array(json_obj.outbounds)) {
        for (let ob in json_obj.outbounds) {
            if (ob.protocol == "vless" && ob.settings && ob.settings.reverse && ob.settings.reverse.tag) {
                if (length(trim(ob.settings.reverse.tag)) > 0) {
                    has_modern_reverse = true;
                }
            }
        }
    }

    if (!has_modern_reverse) {
        return { ok: false, error: "Policy violation: at least one VLESS outbound must contain settings.reverse.tag" };
    }

    return { ok: true };
}

function validate_content_full(content_str) {
    if (!content_str || length(content_str) == 0) {
        return { ok: false, error: "Profile content is empty" };
    }
    if (length(content_str) > 524288) {
        return { ok: false, error: "Profile size exceeds 512 KiB limit" };
    }

    let parsed = null;
    try {
        parsed = json(content_str);
    } catch (e) {
        return { ok: false, error: "Invalid JSON syntax" };
    }

    let pol = validate_policy(parsed);
    if (!pol.ok) {
        return pol;
    }

    // Binary existence check - hard failure if missing or non-executable
    if (!access(XRAY_BIN)) {
        return { ok: false, error: "Xray runtime binary missing or not executable" };
    }

    // Write to temporary file with mode 0600 created before writing
    ensure_dirs();
    let tmp_path = `${BASE_PROFILES_DIR}/.tmp_test_${time()}_${int(rand() * 100000)}.json`;
    let fh = open(tmp_path, "w", 0600);
    if (!fh) {
        return { ok: false, error: "Failed to open temporary file with mode 0600 for validation" };
    }
    fh.write(content_str);
    fh.close();
    chmod(tmp_path, 0600);

    let test_cmd = `XRAY_LOCATION_ASSET="${ASSET_DIR}" "${XRAY_BIN}" run -test -config "${tmp_path}"`;
    let run_res = run_process(test_cmd);
    unlink(tmp_path);

    if (run_res.exit_code !== 0) {
        return { ok: false, error: `Xray configuration validation test failed (exit code ${run_res.exit_code})` };
    }

    return { ok: true };
}

// -------------------------------------------------------------
// RPC Method Handlers
// -------------------------------------------------------------

function rpc_list() {
    ensure_dirs();
    let u = get_uci();
    let profiles = [];
    let instances = get_procd_instances();

    u.load("xray_core");
    u.foreach("xray_core", "profile", function(s) {
        let id = s[".name"];
        let filename = s.filename || `${id}.json`;
        let filepath = `${BASE_PROFILES_DIR}/${filename}`;
        let st = stat(filepath);
        let exists = st ? true : false;
        let size = st ? st.size : 0;
        let mtime = st ? st.mtime : 0;
        let hash = exists ? get_sha256(filepath, true) : "";

        let instance_key = `profile_${id}`;
        let inst = instances[instance_key] || {};
        let is_running = (inst.running && inst.pid > 0) ? true : false;
        let pid = is_running ? inst.pid : null;

        push(profiles, {
            id: id,
            name: s.name || id,
            filename: filename,
            order: int(s.order) || 0,
            autostart: s.autostart == "1",
            exists: exists,
            size: size,
            sha256: hash ? substr(hash, 0, 12) : "",
            mtime: mtime,
            running: is_running,
            pid: pid,
            last_error: null
        });
    });

    // Check system status
    let bin_found = access(XRAY_BIN) ? true : false;
    let bin_ver = "";
    if (bin_found) {
        let v_out = run_cmd(`"${XRAY_BIN}" version 2>/dev/null`);
        let lines = split(v_out, "\n");
        bin_ver = lines[0] || "26.7.28";
    }

    let geoip_found = (access(`${ASSET_DIR}/geoip.dat`) || access("/usr/share/xray/geoip.dat")) ? true : false;
    let geosite_found = (access(`${ASSET_DIR}/geosite.dat`) || access("/usr/share/xray/geosite.dat")) ? true : false;

    let running_cnt = 0;
    let failed_cnt = 0;
    for (let p in profiles) {
        if (p.running) {
            running_cnt++;
        } else {
            let inst = instances[`profile_${p.id}`];
            if (inst && (inst.running === false || inst.running === 0) && inst.respawn_count && inst.respawn_count > 0) {
                failed_cnt++;
            }
        }
    }

    let service_enabled = false;
    if (access(INIT_SCRIPT)) {
        let en_res = run_process(`"${INIT_SCRIPT}" enabled 2>&1`);
        service_enabled = (en_res.exit_code === 0);
    }

    let legacy_running = false;
    let legacy_ubus = run_cmd("ubus call service list '{\"name\": \"xray_core\"}' 2>/dev/null");
    if (index(legacy_ubus, '"running": true') >= 0 || index(legacy_ubus, '"running":true') >= 0) {
        legacy_running = true;
    }

    return {
        ok: true,
        profiles: profiles,
        summary: {
            binary_path: XRAY_BIN,
            binary_found: bin_found,
            binary_version: bin_ver,
            assets_found: geoip_found && geosite_found,
            stored_count: length(profiles),
            running_count: running_cnt,
            failed_count: failed_cnt,
            service_enabled: service_enabled,
            legacy_running: legacy_running
        }
    };
}

function rpc_validate(params) {
    let content = params.content;
    return validate_content_full(content);
}

function rpc_import(params) {
    let name = trim(params.name || "");
    let filename = trim(params.filename || "");
    let content = params.content || "";
    let autostart = params.autostart ? "1" : "0";

    if (!is_valid_name(name)) {
        return { ok: false, error: "Invalid profile name" };
    }
    if (!is_valid_filename(filename)) {
        return { ok: false, error: "Invalid canonical filename (must match ^[a-zA-Z0-9_-]+\\.json$)" };
    }

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let val = validate_content_full(content);
        if (!val.ok) {
            release_lock();
            return val;
        }

        ensure_dirs();
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;

        // Reject existing symlinks using real lstat check
        let target_lst = lstat(target_path);
        if (target_lst && target_lst.type == "link") {
            release_lock();
            return { ok: false, error: "Target destination is a symbolic link; replacement forbidden" };
        }

        let id = sanitize_id(replace(filename, /\.json$/i, ""));
        if (!is_valid_id(id)) {
            release_lock();
            return { ok: false, error: "Generated profile ID is invalid" };
        }

        let u = get_uci();
        u.load("xray_core");

        // Check duplicate ID or filename
        let exists_in_uci = false;
        u.foreach("xray_core", "profile", function(s) {
            if (s[".name"] == id || s.filename == filename) {
                exists_in_uci = true;
            }
        });

        if (exists_in_uci) {
            release_lock();
            return { ok: false, error: `Profile with ID '${id}' or filename '${filename}' already exists in configuration` };
        }

        // Orphan regular file check: if file exists on disk but not registered in UCI, reject to prevent silent overwrite
        if (access(target_path) && !exists_in_uci) {
            release_lock();
            return { ok: false, error: `Unmanaged orphan file '${filename}' already exists at destination; import rejected` };
        }

        // Write to temporary file created with mode 0600 BEFORE content write
        let tmp_path = `${BASE_PROFILES_DIR}/.tmp_import_${id}_${time()}_${int(rand() * 100000)}.json`;
        let fh = open(tmp_path, "w", 0600);
        if (!fh) {
            release_lock();
            return { ok: false, error: "Failed to open temporary file with mode 0600" };
        }
        fh.write(content);
        fh.close();
        chmod(tmp_path, 0600);

        // Atomically rename into place
        if (!rename(tmp_path, target_path)) {
            unlink(tmp_path);
            release_lock();
            return { ok: false, error: "Failed to atomically install profile file" };
        }
        chmod(target_path, 0600);

        // Add UCI metadata section
        u.section("xray_core", "profile", id, {
            name: name,
            filename: filename,
            order: "0",
            autostart: autostart
        });
        u.commit("xray_core");

        if (autostart == "1" && access(INIT_SCRIPT)) {
            run_cmd(`"${INIT_SCRIPT}" start "${id}" >/dev/null 2>&1`);
        }

        release_lock();
        return { ok: true, id: id, filename: filename };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Import failed: ${e}` };
    }
}

function rpc_replace(params) {
    let id = trim(params.id || "");
    let content = params.content || "";

    if (!is_valid_id(id)) {
        return { ok: false, error: "Invalid profile ID" };
    }

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let u = get_uci();
        u.load("xray_core");
        let profile_sec = u.get("xray_core", id);
        if (!profile_sec || profile_sec[".type"] != "profile") {
            release_lock();
            return { ok: false, error: `Profile '${id}' not found` };
        }

        let val = validate_content_full(content);
        if (!val.ok) {
            release_lock();
            return val;
        }

        let filename = profile_sec.filename || `${id}.json`;
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;
        let backup_path = `${BASE_PROFILES_DIR}/.bak_${id}_${time()}.json`;
        let tmp_path = `${BASE_PROFILES_DIR}/.tmp_replace_${id}_${time()}.json`;

        ensure_dirs();

        // Reject existing symlinks using real lstat check
        let target_lst = lstat(target_path);
        if (target_lst && target_lst.type == "link") {
            release_lock();
            return { ok: false, error: "Target destination is a symbolic link; replacement forbidden" };
        }

        // Check running state
        let instances = get_procd_instances();
        let was_running = (instances[`profile_${id}`] && instances[`profile_${id}`].running) ? true : false;

        // Backup previous valid file
        if (access(target_path)) {
            rename(target_path, backup_path);
        }

        // Write new content to tmp file with mode 0600 and atomically rename
        let fh = open(tmp_path, "w", 0600);
        if (!fh) {
            if (access(backup_path)) rename(backup_path, target_path);
            release_lock();
            return { ok: false, error: "Failed to open temporary file with mode 0600" };
        }
        fh.write(content);
        fh.close();
        chmod(tmp_path, 0600);

        if (!rename(tmp_path, target_path)) {
            if (access(backup_path)) rename(backup_path, target_path);
            unlink(tmp_path);
            release_lock();
            return { ok: false, error: "Failed to atomically replace profile file" };
        }
        chmod(target_path, 0600);

        // If was running, restart instance with bounded verification
        if (was_running && access(INIT_SCRIPT)) {
            run_cmd(`"${INIT_SCRIPT}" restart "${id}" 2>&1`);
            let poll = poll_instance_state(id, true, 3000);
            if (!poll.ok || !poll.running) {
                // Rollback on restart failure
                if (access(backup_path)) {
                    rename(backup_path, target_path);
                    run_cmd(`"${INIT_SCRIPT}" restart "${id}" >/dev/null 2>&1`);
                }
                release_lock();
                return { ok: false, error: "Restart failed on replacement; rolled back to previous valid profile" };
            }
        }

        if (access(backup_path)) {
            unlink(backup_path);
        }

        release_lock();
        return { ok: true };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Replace failed: ${e}` };
    }
}

function rpc_delete(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!acquire_lock()) {
        return { ok: false, error: "Concurrent operation in progress; lock busy" };
    }

    try {
        let u = get_uci();
        u.load("xray_core");
        let profile_sec = u.get("xray_core", id);
        if (!profile_sec) {
            release_lock();
            return { ok: false, error: `Profile '${id}' not found` };
        }

        let filename = profile_sec.filename || `${id}.json`;
        let target_path = `${BASE_PROFILES_DIR}/${filename}`;

        // Stop procd instance
        if (access(INIT_SCRIPT)) {
            run_cmd(`"${INIT_SCRIPT}" stop "${id}" >/dev/null 2>&1`);
        }

        // Move file to .trash/
        ensure_dirs();
        let target_lst = lstat(target_path);
        if (target_lst) {
            if (target_lst.type == "link") {
                unlink(target_path);
            } else if (access(target_path)) {
                let trash_dest = `${TRASH_DIR}/${time()}_${filename}`;
                if (!rename(target_path, trash_dest)) {
                    release_lock();
                    return { ok: false, error: "Failed to archive profile file into .trash/" };
                }
                chmod(trash_dest, 0600);
            }
        }

        u.delete("xray_core", id);
        u.commit("xray_core");

        release_lock();
        return { ok: true };
    } catch (e) {
        release_lock();
        return { ok: false, error: `Delete failed: ${e}` };
    }
}

function rpc_start(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found in configuration` };
    }

    let filename = profile_sec.filename || `${id}.json`;
    let filepath = `${BASE_PROFILES_DIR}/${filename}`;
    if (!access(filepath)) {
        return { ok: false, error: `Profile file '${filename}' missing from storage` };
    }

    let res = run_process(`"${INIT_SCRIPT}" start "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service start" };
    }

    let poll = poll_instance_state(id, true, 3000);
    if (poll.ok && poll.running && poll.pid > 0) {
        return { ok: true, running: true, pid: poll.pid };
    } else {
        return { ok: false, error: "Profile failed to start or exited immediately" };
    }
}

function rpc_stop(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let res = run_process(`"${INIT_SCRIPT}" stop "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service stop" };
    }

    let poll = poll_instance_state(id, false, 3000);
    if (!poll.ok && poll.running) {
        return { ok: false, error: "Profile failed to stop within timeout" };
    }
    return { ok: true, running: false };
}

function rpc_restart(params) {
    let id = trim(params.id || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found in configuration` };
    }

    let filename = profile_sec.filename || `${id}.json`;
    let filepath = `${BASE_PROFILES_DIR}/${filename}`;
    if (!access(filepath)) {
        return { ok: false, error: `Profile file '${filename}' missing from storage` };
    }

    let res = run_process(`"${INIT_SCRIPT}" restart "${id}"`);
    if (res.exit_code !== 0) {
        return { ok: false, error: "Failed to invoke service restart" };
    }

    let poll = poll_instance_state(id, true, 3000);
    if (poll.ok && poll.running && poll.pid > 0) {
        return { ok: true, running: true, pid: poll.pid };
    } else {
        return { ok: false, error: "Profile failed to restart or exited immediately" };
    }
}

function rpc_set_autostart(params) {
    let id = trim(params.id || "");
    let autostart = params.autostart ? "1" : "0";
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    u.set("xray_core", id, "autostart", autostart);
    u.commit("xray_core");
    return { ok: true };
}

function rpc_rename(params) {
    let id = trim(params.id || "");
    let name = trim(params.name || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };
    if (!is_valid_name(name)) return { ok: false, error: "Invalid profile name" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    u.set("xray_core", id, "name", name);
    u.commit("xray_core");
    return { ok: true };
}

function rpc_reorder(params) {
    let id = trim(params.id || "");
    let direction = trim(params.direction || "");
    if (!is_valid_id(id)) return { ok: false, error: "Invalid profile ID" };

    let u = get_uci();
    u.load("xray_core");
    let profile_sec = u.get("xray_core", id);
    if (!profile_sec || profile_sec[".type"] != "profile") {
        return { ok: false, error: `Profile '${id}' not found` };
    }

    let current_order = int(u.get("xray_core", id, "order") || "0");
    if (direction == "up") {
        current_order = current_order > 0 ? current_order - 1 : 0;
    } else if (direction == "down") {
        current_order = current_order + 1;
    }
    u.set("xray_core", id, "order", sprintf("%d", current_order));
    u.commit("xray_core");
    return { ok: true, order: current_order };
}

function rpc_enable_service() {
    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }
    let res = run_process(`"${INIT_SCRIPT}" enable 2>&1`);
    return { ok: res.exit_code === 0 };
}

function rpc_disable_service() {
    if (!access(INIT_SCRIPT)) {
        return { ok: false, error: "Init service script missing or not executable" };
    }
    let res = run_process(`"${INIT_SCRIPT}" disable 2>&1`);
    return { ok: res.exit_code === 0 };
}

function rpc_disable_legacy() {
    if (access(LEGACY_INIT)) {
        run_process(`"${LEGACY_INIT}" disable 2>&1`);
        run_process(`"${LEGACY_INIT}" stop 2>&1`);
    }
    return { ok: true };
}

function rpc_diagnostic() {
    let l = rpc_list();
    return { ok: true, summary: l.summary };
}

// -------------------------------------------------------------
// RPCD CLI Interface Dispatcher
// -------------------------------------------------------------

if (cmd == "list") {
    printf("%.4J\n", {
        list: {},
        validate: { content: "str" },
        import: { name: "str", filename: "str", content: "str", autostart: "bool" },
        replace: { id: "str", content: "str" },
        delete: { id: "str" },
        start: { id: "str" },
        stop: { id: "str" },
        restart: { id: "str" },
        set_autostart: { id: "str", autostart: "bool" },
        rename: { id: "str", name: "str" },
        reorder: { id: "str", direction: "str" },
        enable_service: {},
        disable_service: {},
        disable_legacy: {},
        diagnostic: {}
    });
    exit(0);
}

if (cmd == "call") {
    let res = { ok: false, error: `Unknown RPC method '${method}'` };
    if (method == "list") res = rpc_list();
    else if (method == "validate") res = rpc_validate(args);
    else if (method == "import") res = rpc_import(args);
    else if (method == "replace") res = rpc_replace(args);
    else if (method == "delete") res = rpc_delete(args);
    else if (method == "start") res = rpc_start(args);
    else if (method == "stop") res = rpc_stop(args);
    else if (method == "restart") res = rpc_restart(args);
    else if (method == "set_autostart") res = rpc_set_autostart(args);
    else if (method == "rename") res = rpc_rename(args);
    else if (method == "reorder") res = rpc_reorder(args);
    else if (method == "enable_service") res = rpc_enable_service();
    else if (method == "disable_service") res = rpc_disable_service();
    else if (method == "disable_legacy") res = rpc_disable_legacy();
    else if (method == "diagnostic") res = rpc_diagnostic();

    printf("%.4J\n", res);
    exit(res.ok ? 0 : 1);
}

// Default fallback
printf("%.4J\n", { ok: false, error: "Usage: xray_profiles [list | call <method> [args_json]]" });
exit(1);
