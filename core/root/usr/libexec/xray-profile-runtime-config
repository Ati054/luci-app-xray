#!/usr/bin/ucode
"use strict";

import { readfile } from "fs";

const source_path = getenv("XRAY_PROFILE_SOURCE");
const keepalive_idle = +getenv("XRAY_PROFILE_TCP_KEEPALIVE_IDLE") || 10;
const keepalive_interval = +getenv("XRAY_PROFILE_TCP_KEEPALIVE_INTERVAL") || 3;
const user_timeout = +getenv("XRAY_PROFILE_TCP_USER_TIMEOUT") || 15000;

if (!source_path)
    die("XRAY_PROFILE_SOURCE is required");

let profile;
try {
    profile = json(readfile(source_path));
}
catch (e) {
    die(`Unable to parse profile JSON: ${e}`);
}

if (type(profile) != "object" || type(profile.outbounds) != "array")
    die("Profile must contain an outbounds array");

let reverse_outbounds = 0;
for (let outbound in profile.outbounds) {
    if (type(outbound) != "object" || type(outbound.settings) != "object" ||
        type(outbound.settings.reverse) != "object")
        continue;

    reverse_outbounds++;
    if (type(outbound.streamSettings) != "object")
        outbound.streamSettings = {};
    if (type(outbound.streamSettings.sockopt) != "object")
        outbound.streamSettings.sockopt = {};

    let sockopt = outbound.streamSettings.sockopt;
    if (sockopt.tcpKeepAliveIdle == null)
        sockopt.tcpKeepAliveIdle = keepalive_idle;
    if (sockopt.tcpKeepAliveInterval == null)
        sockopt.tcpKeepAliveInterval = keepalive_interval;
    if (sockopt.tcpUserTimeout == null)
        sockopt.tcpUserTimeout = user_timeout;
}

if (!reverse_outbounds)
    die("Profile contains no VLESS Reverse outbound");

printf("%.4J\n", profile);
